# 복사해서 .env로 만든 뒤 값을 채워 넣으세요. (.env는 커밋되지 않음)
# EXPO_PUBLIC_ 값은 앱 번들에 포함되므로 비밀 키는 넣지 마세요.

# 에뮬레이터에서 로컬 백엔드: http://10.0.2.2:8080
# 실기기에서 로컬 백엔드: http://{PC 내부 IP}:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# 목업 API 사용 여부 (true/false). 비우면 개발 빌드에서만 목업을 쓴다.
# 시연용 preview APK는 eas.json에서 false와 개발 서버 주소를 넣는다.
EXPO_PUBLIC_USE_MOCK=

# 시연용: 04 블록 확정 직후 확정일을 이번 달 1일로 옮긴다 (소진 그래프 채우기, 개발 서버 전용)
# 시연용 preview APK는 eas.json에서 true로 넣는다. 평소엔 비워 둔다.
EXPO_PUBLIC_DEMO_BACKDATE=

# 카카오/구글 버튼을 누르면 이 계정으로 로그인한다 (실제 소셜 로그인 아님)
# 비우면 목업 모드에서는 목업 계정(test@example.com), 아니면 버튼이 동작하지 않는다.
# 저장소가 공개라 eas.json에 비밀번호를 넣지 말고 EAS 환경 변수(eas env:create)로 넣는다.
EXPO_PUBLIC_SOCIAL_LOGIN_EMAIL=
EXPO_PUBLIC_SOCIAL_LOGIN_PASSWORD=
